{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CISEM Exchange Packet Schema V1.2",
  "type": "object",
  "required": [
    "protocol",
    "identity",
    "immutable_request",
    "event_stream",
    "derived_view",
    "integrity"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "type": "object",
      "required": ["protocol_name", "protocol_version", "schema_version", "adapter_contract_version"],
      "additionalProperties": false,
      "properties": {
        "protocol_name": { "type": "string", "enum": ["CXP"] },
        "protocol_version": { "type": "string", "enum": ["1.2"] },
        "schema_version": { "type": "string", "enum": ["1.2"] },
        "adapter_contract_version": { "type": "string" },
        "repository_snapshot": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "required": ["project", "core_cycle", "purpose"],
      "additionalProperties": false,
      "properties": {
        "project": { "type": "string" },
        "core_cycle": { "type": "string" },
        "purpose": { "type": "string" }
      }
    },
    "immutable_request": {
      "type": "object",
      "required": ["header", "repository_target", "authority", "governance", "execution"],
      "additionalProperties": false,
      "properties": {
        "header": {
          "type": "object",
          "required": ["packet_id", "timestamp", "sender", "recipient"],
          "additionalProperties": false,
          "properties": {
            "packet_id": { 
              "type": "string", 
              "pattern": "^CXP-PKT-\\d{8}-\\d{6}$" 
            },
            "timestamp": { "type": "string", "format": "date-time" },
            "sender": { "type": "string" },
            "recipient": { "type": "string" }
          }
        },
        "repository_target": {
          "type": "object",
          "required": ["path", "branch", "commit_before", "dirty_before"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string" },
            "branch": { "type": "string" },
            "commit_before": { "type": "string" },
            "dirty_before": { "type": "boolean" }
          }
        },
        "authority": {
          "type": "object",
          "required": ["ratifying_authority", "human_bridge", "issuing_system", "implementation_adapter"],
          "additionalProperties": false,
          "properties": {
            "ratifying_authority": {
              "type": "object",
              "required": ["identity", "role"],
              "additionalProperties": false,
              "properties": {
                "identity": { "type": "string" },
                "role": { "type": "string", "enum": ["Governor"] }
              }
            },
            "human_bridge": {
              "type": "object",
              "required": ["identity", "enabled", "role"],
              "additionalProperties": false,
              "properties": {
                "identity": { "type": "string" },
                "enabled": { "type": "boolean" },
                "role": { "type": "string" }
              }
            },
            "issuing_system": {
              "type": "object",
              "required": ["identity", "authority_scope"],
              "additionalProperties": false,
              "properties": {
                "identity": { "type": "string" },
                "authority_scope": { "type": "array", "items": { "type": "string" } }
              }
            },
            "implementation_adapter": {
              "type": "object",
              "required": ["identity", "authority_scope"],
              "additionalProperties": false,
              "properties": {
                "identity": { "type": "string" },
                "authority_scope": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "governance": {
          "type": "object",
          "required": ["dependencies", "blocking_conditions", "parking_rules", "acceptance_criteria"],
          "additionalProperties": false,
          "properties": {
            "dependencies": { "type": "array", "items": { "type": "string" } },
            "blocking_conditions": { "type": "array", "items": { "type": "string" } },
            "parking_rules": { "type": "array", "items": { "type": "string" } },
            "acceptance_criteria": { "type": "array", "items": { "type": "string" } }
          }
        },
        "execution": {
          "type": "object",
          "required": ["intent", "parameters", "inputs", "required_outputs", "evidence_required"],
          "additionalProperties": false,
          "properties": {
            "intent": { "type": "string" },
            "parameters": { "type": "object" },
            "inputs": { "type": "object" },
            "required_outputs": { "type": "array", "items": { "type": "string" } },
            "evidence_required": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "event_stream": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "sequence_number",
          "previous_event_id",
          "packet_id",
          "actor",
          "occurred_at",
          "recorded_at",
          "transition",
          "payload"
        ],
        "additionalProperties": false,
        "properties": {
          "event_id": { 
            "type": "string", 
            "pattern": "^CXP-EVT-\\d{8}-\\d{6}-\\d{6}$" 
          },
          "event_type": { 
            "type": "string",
            "enum": [
              "PACKET_CREATED",
              "PACKET_PUBLISHED",
              "PACKET_CLAIMED",
              "EXECUTION_STARTED",
              "EXECUTION_OUTPUT_RECORDED",
              "EXECUTION_FAILED",
              "EVIDENCE_RECORDED",
              "VALIDATION_PASSED",
              "VALIDATION_FAILED",
              "PACKET_COMPLETED",
              "AUDIT_STARTED",
              "AUDIT_VERIFIED",
              "AUDIT_REJECTED",
              "PACKET_ARCHIVED"
            ]
          },
          "sequence_number": { "type": "integer", "minimum": 1 },
          "previous_event_id": { "type": "string" },
          "packet_id": { "type": "string", "pattern": "^CXP-PKT-\\d{8}-\\d{6}$" },
          "actor": {
            "type": "object",
            "required": ["identity", "role"],
            "additionalProperties": false,
            "properties": {
              "identity": { "type": "string" },
              "role": { "type": "string" }
            }
          },
          "occurred_at": { "type": "string", "format": "date-time" },
          "recorded_at": { "type": "string", "format": "date-time" },
          "transition": {
            "type": "object",
            "required": ["from_state", "to_state", "transition_id"],
            "additionalProperties": false,
            "properties": {
              "from_state": { "type": "string" },
              "to_state": { "type": "string" },
              "transition_id": { "type": "string" }
            }
          },
          "payload": { "type": "object" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "correlation_id": { "type": "string" },
          "causation_event_id": { "type": "string" },
          "schema_version": { "type": "string" },
          "integrity": {
            "type": "object",
            "required": ["content_hash"],
            "additionalProperties": false,
            "properties": {
              "content_hash": { "type": "string" }
            }
          }
        }
      }
    },
    "derived_view": {
      "type": "object",
      "required": ["current_state", "execution_control", "response", "audit", "lessons_learned"],
      "additionalProperties": false,
      "properties": {
        "current_state": { 
          "type": "string",
          "enum": [
            "CREATED", "READY", "CLAIMED", "EXECUTING", "VALIDATING", 
            "COMPLETED", "FAILED", "BLOCKED", "AWAITING_RATIFICATION", 
            "EXPIRED", "CANCELLED", "AUDITED", "ARCHIVED"
          ]
        },
        "execution_control": {
          "type": "object",
          "required": ["idempotency_key", "attempt_number", "max_attempts", "claimed_by", "claimed_at", "lease_expires_at", "timeout_seconds", "requires_clean_repository"],
          "additionalProperties": false,
          "properties": {
            "idempotency_key": { "type": "string" },
            "attempt_number": { "type": "integer" },
            "max_attempts": { "type": "integer" },
            "claimed_by": { "type": "string" },
            "claimed_at": { "type": "string" },
            "lease_expires_at": { "type": "string" },
            "timeout_seconds": { "type": "integer" },
            "requires_clean_repository": { "type": "boolean" }
          }
        },
        "response": {
          "type": "object",
          "required": ["status", "stdout", "stderr", "evidence"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string" },
            "stdout": { "type": "string" },
            "stderr": { "type": "string" },
            "evidence": { "type": "object" }
          }
        },
        "audit": {
          "type": "object",
          "required": ["result", "auditor_id", "timestamp"],
          "additionalProperties": false,
          "properties": {
            "result": { "type": "string" },
            "auditor_id": { "type": "string" },
            "timestamp": { "type": "string" }
          }
        },
        "lessons_learned": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lesson_id",
              "source_packet_id",
              "source_event_ids",
              "category",
              "observation",
              "context",
              "evidence_refs",
              "proposed_improvement",
              "applicability",
              "status",
              "maturity",
              "proposed_canonical_home",
              "requires_human_ratification"
            ],
            "additionalProperties": false,
            "properties": {
              "lesson_id": { "type": "string", "pattern": "^CXP-LESSON-\\d{6}$" },
              "source_packet_id": { "type": "string", "pattern": "^CXP-PKT-\\d{8}-\\d{6}$" },
              "source_event_ids": { "type": "array", "items": { "type": "string" } },
              "category": { "type": "string" },
              "observation": { "type": "string" },
              "context": { "type": "string" },
              "evidence_refs": { "type": "array", "items": { "type": "string" } },
              "proposed_improvement": { "type": "string" },
              "applicability": {
                "type": "object",
                "required": ["scope"],
                "additionalProperties": false,
                "properties": {
                  "scope": { "type": "string", "enum": ["LOCAL", "ADAPTER", "PROJECT", "UNIVERSAL"] }
                }
              },
              "status": { "type": "string", "enum": ["CAPTURED", "REVIEWED", "APPLIED"] },
              "maturity": { "type": "string", "enum": ["RAW", "REFINED", "RATIFIED"] },
              "proposed_canonical_home": { "type": "string" },
              "requires_human_ratification": { "type": "boolean" }
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["packet_hash", "latest_event_hash"],
      "additionalProperties": false,
      "properties": {
        "packet_hash": { "type": "string" },
        "latest_event_hash": { "type": "string" }
      }
    }
  }
}
