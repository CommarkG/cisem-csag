{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TagLibrary",
  "type": "object",
  "required": ["tags"],
  "properties": {
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tag_id", "label", "description"],
        "properties": {
          "tag_id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "owner_role": { "type": "string", "enum": ["operator_admin", "partner", "buyer", "governor"] }
        }
      }
    }
  }
}
