{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NormalizedFinding",
  "type": "object",
  "required": [
    "finding_id",
    "reviewer_id",
    "category",
    "severity",
    "confidence",
    "title",
    "description",
    "affected_files"
  ],
  "properties": {
    "finding_id": { "type": "string" },
    "reviewer_id": { "type": "string" },
    "category": { "type": "string", "enum": ["CORRECTNESS", "SECURITY", "STYLE", "DESTRUCTIVE", "ARCHITECTURE"] },
    "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"] },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "affected_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "affected_lines": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reproduction_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_resolution": { "type": "string" },
    "blocks_completion": { "type": "boolean" }
  }
}
