{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StatusLibrary",
  "type": "object",
  "required": ["statuses"],
  "properties": {
    "statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status_id", "label", "description", "requires_governor_sig"],
        "properties": {
          "status_id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "requires_governor_sig": { "type": "boolean" }
        }
      }
    }
  }
}
